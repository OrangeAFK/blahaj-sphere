    "/api/rfic/run": {
      "post": {
        "summary": "Run Sim",
        "description": "Run a sim as a job (streams to /api/jobs/stream). Path rules as for the MCP tools, pinned to `node`.",
        "operationId": "runRficSim",
        "requestBody": {
          "content": {
