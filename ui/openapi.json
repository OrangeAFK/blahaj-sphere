    "/api/rfic/gui": {
      "post": {
        "summary": "Launch Gui",
        "description": "Start a GUI tool on the container's VNC display and open noVNC in the system browser.",
        "operationId": "launchRficGui",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GuiRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
