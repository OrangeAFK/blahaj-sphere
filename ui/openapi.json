  "components": {
    "schemas": {
      "AnswerBody": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          }
        },
        "type": "object",
        "required": [
          "answer"
        ],
        "title": "AnswerBody"
      },
      "AnswerResult": {
        "properties": {
          "score": {
            "type": "integer",
            "title": "Score"
          },
          "view": {
            "$ref": "#/components/schemas/DiagnosticView"
          }
        },
        "type": "object",
        "required": [
          "score",
          "view"
        ],
        "title": "AnswerResult"
      },
      "ApproveBody": {
        "properties": {
          "framework": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Framework"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "title": "ApproveBody"
      },
      "Check": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "warn",
              "fail"
            ],
            "title": "Status"
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "default": ""
          },
          "fix": {
            "type": "string",
            "title": "Fix",
            "default": ""
          },
          "fix_action": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fix Action"
          }
        },
        "type": "object",
        "required": [
          "id",
          "label",
          "status"
        ],
        "title": "Check"
      },
      "ContainerStatus": {
        "properties": {
          "image": {
            "type": "string",
            "title": "Image"
          },
          "image_present": {
            "type": "boolean",
            "title": "Image Present"
          },
          "container": {
            "type": "string",
            "title": "Container"
          },
          "running": {
            "type": "boolean",
            "title": "Running"
          },
          "nodes_root": {
            "type": "string",
            "title": "Nodes Root"
          },
          "gui_port": {
            "type": "integer",
            "title": "Gui Port"
          },
          "jupyter_port": {
            "type": "integer",
            "title": "Jupyter Port"
          }
        },
        "type": "object",
        "required": [
          "image",
          "image_present",
          "container",
          "running",
          "nodes_root",
          "gui_port",
          "jupyter_port"
        ],
        "title": "ContainerStatus"
      },
      "DiagnosticDomain": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "done": {
            "type": "boolean",
            "title": "Done"
          },
          "probes": {
            "items": {
              "$ref": "#/components/schemas/ProbeResult"
            },
            "type": "array",
            "title": "Probes"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "done",
          "probes"
        ],
        "title": "DiagnosticDomain"
      },
      "DiagnosticView": {
        "properties": {
          "done": {
            "type": "boolean",
            "title": "Done"
          },
          "pending": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProbeView"
              },
              {
                "type": "null"
              }
            ]
          },
          "tiers": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "integer"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tiers"
          },
          "domains": {
            "items": {
              "$ref": "#/components/schemas/DiagnosticDomain"
            },
            "type": "array",
            "title": "Domains"
          }
        },
        "type": "object",
        "required": [
          "done",
          "pending",
          "tiers",
          "domains"
        ],
        "title": "DiagnosticView"
      },
      "Framework": {
        "properties": {
          "domain_pack": {
            "type": "string",
            "title": "Domain Pack"
          },
          "version": {
            "type": "integer",
            "title": "Version",
            "default": 1
          },
          "domains": {
            "items": {
              "$ref": "#/components/schemas/FrameworkDomain"
            },
            "type": "array",
            "title": "Domains"
          }
        },
        "type": "object",
        "required": [
          "domain_pack",
          "domains"
        ],
        "title": "Framework"
      },
      "FrameworkDomain": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "scope": {
            "type": "string",
            "title": "Scope",
            "default": ""
          },
          "subskills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Subskills",
            "default": []
          },
          "tiers": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Tiers"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "tiers"
        ],
        "title": "FrameworkDomain"
      },
      "FrameworkView": {
        "properties": {
          "frozen": {
            "type": "boolean",
            "title": "Frozen"
          },
          "framework": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Framework"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "frozen",
          "framework"
        ],
        "title": "FrameworkView"
      },
      "GoalsBody": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "GoalsBody"
      },
      "GuiRequest": {
        "properties": {
          "tool": {
            "type": "string",
            "enum": [
              "xschem",
              "klayout",
              "qucs-s",
              "desktop"
            ],
            "title": "Tool",
            "default": "xschem"
          },
          "node": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Node"
          },
          "file": {
            "anyOf": [
